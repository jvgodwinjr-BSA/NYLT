# Served from the repository root (Hostinger deploys the repo as-is).

Options -Indexes

<IfModule mod_headers.c>
  # The app is plain ES modules with no build step and no content-hashed filenames, and
  # Hostinger's default is max-age=604800 — a week. That means a pushed fix would not reach
  # anyone already running the old copy until their cache expired. Revalidate instead: the
  # browser still caches, but checks first, so a 304 stays cheap and a fix is live on reload.
  <FilesMatch "\.(html|js|mjs|css|csv|json|enc)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
    Header unset Pragma
  </FilesMatch>

  # The shared schedule and the roster must never sit in a shared cache.
  <FilesMatch "\.(php|enc)$">
    Header set Cache-Control "no-store"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# Source material and local-only files are never part of the site.
<FilesMatch "\.(xlsx|local\.csv|local\.txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
