# Real names never go in the repo. See docs/DATA-MODEL.md "Roster".
roster.local.csv
# Source spreadsheets (contain names). Keep them in the shared Drive folder.
source/
*.xlsx
# Build output and deps
dist/
node_modules/
# OS / editor
.DS_Store
Thumbs.db
# Extra scrub list for the importer (contains names)
scripts/scrub.local.txt

# The live shared schedule, written by api/placements.php
api/data/*.json

# Saved schedules. `Save JSON` in the app writes <pack>-schedule-<timestamp>.json, and
# corrected or hand-authored drafts get the same shape. They are a point-in-time plan, not
# source: they go in the shared Drive folder, or straight into the app with Load JSON.
*-schedule-*.json
*-schedule.json

# Hand-authored task lists. Raw input may name people; the scrubbed output is what is committed.
scripts/*-source.json
