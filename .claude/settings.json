{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:*)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run import-catalog)",
      "Bash(node scripts/*)",
      "Bash(node --check *)",
      "Bash(node --test *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git branch*)",
      "Bash(npm run roster -- list)",
      "Bash(npm run roster -- check)",
      "Bash(npm run roster -- set:*)",
      "Bash(npm run roster)"
    ],
    "deny": [
      "Read(./roster.local.csv)",
      "Read(./scripts/scrub.local.txt)",
      "Read(./source/**)",
      "Bash(npm run roster -- show:*)"
    ]
  }
}
